DATABASE_URL=postgresql://kixvault:kixvault@localhost:5433/kixvault
TEST_DATABASE_URL=postgresql://kixvault:kixvault@localhost:5433/kixvault_test
KICKSDB_API_KEY=KICKS-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REDIS_URL=redis://localhost:6379

SIGNUPS_ENABLED=true

# API logging (silent disables request logs)
LOG_LEVEL=info

# Scheduler (weekly catalog price refresh)
JOB_SCHEDULE=0 3 * * 0
PRICING_REFRESH_DELAY_MS=500

# API (Sentry project: kixvault-api)
SENTRY_RELEASE=

# Web (Vite — prefixed with VITE_ for client exposure)
VITE_APP_VERSION=

# Umami analytics (optional — leave unset for local dev / no tracking)
# VITE_UMAMI_WEBSITE_ID=
# Self-hosted Umami origin (script loads from {domain}/script.js):
# VITE_UMAMI_DOMAIN=https://analytics.example.com
# Or set the full script URL instead of VITE_UMAMI_DOMAIN:
# VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js

# Sentry source map upload (build time only — do not commit)
SENTRY_AUTH_TOKEN=
